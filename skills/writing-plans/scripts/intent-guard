#!/usr/bin/env bash
# Refuse to plan from a spec whose intent is not a committed, accepted intent file.
# Usage: intent-guard SPEC_FILE   (run from the repo that holds the spec)
set -euo pipefail
[ $# -eq 1 ] || { echo "usage: intent-guard SPEC_FILE" >&2; exit 2; }
spec=$1; [ -f "$spec" ] || { echo "intent-guard: no spec at $spec" >&2; exit 2; }
here=$(cd "$(dirname "$0")" && pwd)
source "$here/markdown-reader"
refuse() { echo "intent-guard: REFUSE $1"; exit 1; }
# $(...) silently drops NUL bytes, so refuse them on the byte stream before any parsing.
nul_free() { [ "$(tr -d '\000' | wc -c)" -eq "$1" ]; }
nul_free "$(wc -c < "$spec")" < "$spec" || refuse "spec contains NUL bytes"
intent=$(intent_field "$spec")
[ -n "$intent" ] || refuse "spec has no Intent: line"
[ -L "$intent" ] && refuse "intent is a symlink"
[ -f "$intent" ] || refuse "intent file missing: $intent"
export GIT_LITERAL_PATHSPECS=1
git ls-files --error-unmatch -- "$intent" >/dev/null 2>&1 || refuse "intent is untracked"
git diff --quiet HEAD -- "$intent" || refuse "intent has uncommitted changes"
# Header and Status come from the committed blob, not the worktree copy.
# Template: line 1 `# Intent: <topic>`, then `Author: <who>. Status: draft|accepted`.
# Resolve HEAD once: both reads below use the same immutable blob id.
oid=$(git rev-parse --verify --quiet "HEAD:./$intent" || true)
[ -n "$oid" ] || refuse "intent not in HEAD"
git cat-file blob "$oid" | nul_free "$(git cat-file -s "$oid")" || refuse "intent file contains NUL bytes"
blob=$(git cat-file blob "$oid" 2>/dev/null || true)
[[ "$(head -1 <<<"$blob")" == "# Intent:"* ]] || refuse "not an intent file"
author=$(grep -m1 '^Author:' <<<"$blob" || true)
[[ "$author" != *Status:*Status:* && "$author" =~ [[:space:]]Status:\ accepted[[:space:]]*$ ]] || refuse "intent not Status: accepted"
echo "intent-guard: OK $intent"
