#!/usr/bin/env bash
# Shared by intent-guard and gate-check; source from the caller's script directory.
# Ignore fences (including list/quote containers) and HTML comments; normalize CRLF first.
unfenced() {
  awk 'function run(s, c,  n) { n = 0; while (substr(s, n + 1, 1) == c) n++; return n }
  function fence_text(s) {
    sub(/^[ \t]*/, "", s)
    while (sub(/^([-*+]|[0-9]+[.]|>)[ \t]+/, "", s)) sub(/^[ \t]*/, "", s)
    return s
  }
  {
    sub(/\r$/, "")
    # Comment delimiters inside a fence are literal code.
    if (f != "") {
      t = fence_text($0); n = run(t, f)
      if (n >= len && substr(t, n + 1) ~ /^[ \t]*$/) f = ""
      next
    }
    s = $0; visible = ""
    while (length(s)) {
      if (comment) {
        k = index(s, "-->"); if (!k) break
        s = substr(s, k + 3); comment = 0
      } else {
        k = index(s, "<!--")
        if (!k) { visible = visible s; break }
        visible = visible substr(s, 1, k - 1); s = substr(s, k + 4); comment = 1
      }
    }
    t = fence_text(visible); c = substr(t, 1, 1)
    n = (c == "`" || c == "~") ? run(t, c) : 0
    # Once an opener is visible, its info string cannot start an HTML comment.
    if (n >= 3 && !(c == "`" && index(substr(t, n + 1), "`"))) { f = c; len = n; comment = 0; next }
    print visible
  }' "$1"
}

# Preserve intent-guard's path syntax: optional bold key, backticks and trailing whitespace.
intent_field() {
  unfenced "$1" | sed -nE 's/^(\*\*)?Intent:(\*\*)?[[:space:]]*//p' | head -1 | sed -E 's/[[:space:]]+$//; s/^`(.*)`$/\1/'
}
