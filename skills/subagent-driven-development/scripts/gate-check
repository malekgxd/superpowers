#!/usr/bin/env bash
# Refuse to start executing a plan unless its gates are on record: the plan names a spec and the
# spec's intent, that intent passes intent-guard, and both spec and plan carry a Challenge: line.
# Fields are read only from the header region (line 1 up to the first `## ` line) of the committed
# HEAD blob, which must be NUL-free and match the working-tree header; a code fence or `<!--`
# in that region refuses outright.
# Usage: gate-check PLAN_FILE   (run from the repo that holds the plan)
set -euo pipefail
[ $# -eq 1 ] || { echo "usage: gate-check PLAN_FILE" >&2; exit 2; }
plan=$1; [ -f "$plan" ] || { echo "gate-check: no plan at $plan" >&2; exit 2; }
here=$(cd "$(dirname "$0")" && pwd)
refuse() { echo "gate-check: REFUSE $1"; exit 1; }
region() { awk '{ gsub(/\r/, "") } /^## /{ exit } 1'; }
# $(...) silently drops NUL bytes, so refuse them on the byte stream before any capture.
nul_free() { [ "$(tr -d '\000' | wc -c)" -eq "$1" ]; }
# load LABEL PATH: set hdr to the header region of PATH's committed blob, CR stripped. The blob and
# working-tree file must be NUL-free, and their headers must match so executors read what the gate checked.
load() {
  local ref oid blob top wt
  if [[ "$2" == /* ]]; then
    top=$(git rev-parse --show-toplevel) || refuse "$1 not in a git repo: $2"
    [[ "$2" == "$top"/* ]] || refuse "$1 lies outside the repo: $2"
    ref="HEAD:${2#"$top"/}"
  else
    ref="HEAD:./$2"
  fi
  oid=$(git rev-parse --verify --quiet "$ref" 2>/dev/null) || refuse "$1 not in HEAD: $2"
  git cat-file blob "$oid" | nul_free "$(git cat-file -s "$oid")" || refuse "$1 contains NUL bytes: $2"
  blob=$(git cat-file blob "$oid") || refuse "cannot read $1 from HEAD: $2"
  hdr=$(region <<<"$blob")
  nul_free "$(wc -c < "$2")" < "$2" || refuse "$1 contains NUL bytes: $2"
  wt=$(region < "$2")
  [ "$wt" = "$hdr" ] || refuse "$1 header differs from the committed version: $2"
}
fenced() { grep -qE '```|~~~|<!--' <<<"$1"; }
# One complete .md path after `**Key:**` / `Key:`: the first whitespace-delimited token, minus one
# surrounding pair of ** or backticks. Glob characters or a non-.md ending refuse; never truncate.
path_field() {
  local v
  v=$(sed -nE "s/^(\*\*)?$1:(\*\*)?[[:space:]]*//p" <<<"$2" | head -1)
  v=${v%%[[:space:]]*}
  [[ "$v" == '**'?*'**' ]] && v=${v:2:${#v}-4}
  [[ "$v" == '`'?*'`' ]] && v=${v:1:${#v}-2}
  case "$v" in *[*?[]*) return 1 ;; ?*.md) printf '%s\n' "$v" ;; *) return 1 ;; esac
}
# Exactly one `Challenge: YYYY-MM-DD <verdict>` line (key may be bold, value may be backticked).
challenge() {
  local lines v
  lines=$(grep -E '^(\*\*)?Challenge:' <<<"$2" || true)
  [ -n "$lines" ] || refuse "$1 header has no Challenge: line"
  [ "$(wc -l <<<"$lines")" -eq 1 ] || refuse "$1 header has more than one Challenge: line"
  v=$(sed -E 's/^(\*\*)?Challenge:(\*\*)?[[:space:]]*//; s/[[:space:]]+$//; s/^`(.*)`$/\1/' <<<"$lines")
  [[ "$v" =~ ^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])\ (holds|holds-with-conditions|broken-ruled)$ ]] \
    || refuse "$1 Challenge: line is not 'YYYY-MM-DD holds|holds-with-conditions|broken-ruled': $v"
}

load plan "$plan"; plan_hdr=$hdr
fenced "$plan_hdr" && refuse "plan header holds a code fence or comment; move it below the first ## heading"
spec=$(path_field Spec "$plan_hdr") || refuse "plan has no Spec: line naming one .md path"
[ -f "$spec" ] || refuse "spec file missing: $spec"
intent=$(path_field Intent "$plan_hdr") || refuse "plan has no Intent: line naming one .md path"
[ -f "$intent" ] || refuse "plan Intent file missing: $intent"
load spec "$spec"; spec_hdr=$hdr
fenced "$spec_hdr" && refuse "spec header holds a code fence or comment; move it below the first ## heading"
spec_intent=$(path_field Intent "$spec_hdr") || refuse "spec has no Intent: line naming one .md path"
guard=$("${BASH:-bash}" "$here/../../writing-plans/scripts/intent-guard" "$spec" 2>&1 || true)
[[ "$guard" == "intent-guard: OK "* ]] || refuse "intent-guard on $spec: $guard"
# intent-guard reads the worktree spec; it must have checked the intent the committed spec names.
[ "${guard#intent-guard: OK }" = "$spec_intent" ] \
  || refuse "intent-guard checked ${guard#intent-guard: OK } but the committed spec names $spec_intent"
plan_path=$(realpath -- "$intent") || refuse "cannot resolve intent path"
[ -n "$plan_path" ] || refuse "cannot resolve intent path"
spec_path=$(realpath -- "$spec_intent") || refuse "cannot resolve intent path"
[ -n "$spec_path" ] || refuse "cannot resolve intent path"
[ "$plan_path" = "$spec_path" ] \
  || refuse "plan Intent does not match the spec's Intent: $intent vs $spec_intent"
challenge spec "$spec_hdr"
challenge plan "$plan_hdr"
echo "gate-check: OK"
